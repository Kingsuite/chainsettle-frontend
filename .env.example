# ============================================================
# ChainSettle Frontend — Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# Backend API base URL (optional, defaults to http://localhost:3000/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Stellar Network: testnet | mainnet (optional, defaults to testnet)
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Deployed ChainSettle contract ID (required, 56 characters starting with C)
NEXT_PUBLIC_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# USDC Stellar Asset Contract address (required, 56 characters starting with C)
# Testnet:  CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Mainnet:  CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
NEXT_PUBLIC_USDC_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# Stellar Soroban RPC URL (required)
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Horizon URL for account info (optional, defaults to the Horizon server for the network)
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# IPFS gateway used to open milestone proofs (optional, https only, defaults to https://ipfs.io/ipfs/)
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
